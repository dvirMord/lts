{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KafkaConsumer": {
    "BootstrapServers": "localhost:9092",
    "Topic": "telemetry.packets.raw",
    "GroupIdPrefix": "raven-consumer",
    "EnableAutoCommit": true,
    "AutoOffsetReset": "Latest"
  },
  "AllowedHosts": "*"
}
